PUBLIC_LLM_MODEL=
PUBLIC_LLM_BASE_URL=
PUBLIC_SESSION_TTL_HOURS=24
PUBLIC_SESSION_MAX_PER_IP_PER_HOUR=30

# Tool execution limits (Phase 5)
TOOL_TIMEOUT_S=8
MAX_TOOL_ITERATIONS=5
TIMEZONE=Asia/Kolkata
