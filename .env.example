GEMINI_API_KEY=
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_VOICE=Kore
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://chatbot-ui-navy-eight-17.vercel.app
